#!/bin/sh
# Format check → lint → tests with a 100% coverage gate. Bypass (rarely) with --no-verify.
set -eu
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: format check"; scripts/check-format.sh
echo "pre-commit: lint";         scripts/lint.sh
echo "pre-commit: tests";        scripts/test-coverage.sh
